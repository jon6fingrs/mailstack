# Copy to .env and fill in. `docker compose` reads .env automatically.
# Keep .env private: it holds both passwords.

### Where things live on this machine ###

# Your mail archive (Maildir). mbsync writes it, Dovecot serves it.
MAIL_DIR=/path/to/mail
# Owner of MAIL_DIR (`id -u` and `id -g` of that user). Both containers
# create files as this user. PUID must be 500 or higher.
PUID=1000
PGID=1000
TZ=America/New_York

### The remote account to copy (e.g. Fastmail, Gmail) ###

REMOTE_HOST=imap.fastmail.com
REMOTE_USER=you@example.com
# Usually an app password, not your main password.
REMOTE_PASSWORD=change-me
# A short name for this account; it only appears in mbsync's internals.
ACCOUNT_NAME=fastmail
# Seconds between checks for new mail.
SYNC_INTERVAL=300

### Your local IMAP server ###

# What you type into your mail app. Not related to the remote account.
MAIL_USER=me
# Plain text, or a hash from:
#   docker run --rm --entrypoint doveadm dovecot/dovecot:2.4.5-root pw -s ARGON2ID
# (a hash looks like {ARGON2ID}$argon2id$...; wrap it in single quotes here).
MAIL_PASSWORD=change-me-too

# Port on this machine that mail apps connect to (IMAP over TLS).
IMAPS_PORT=993

# TLS certificate. Leave the file names empty to use a self-signed one (mail
# apps will warn about it). Otherwise point CERT_DIR at the folder with your
# certificate and give the names as seen inside the container (/ssl/...).
# Renewed files are picked up automatically within 5 minutes.
CERT_DIR=./certs
TLS_CERT_FILE=
TLS_KEY_FILE=
# TLS_CERT_FILE=/ssl/fullchain.pem
# TLS_KEY_FILE=/ssl/privkey.pem

### Search ###

# Solr memory. 1g is plenty for a few hundred thousand messages.
SOLR_HEAP=1g

# Pin image versions (e.g. 1.0.0) instead of always using the latest.
# MAILSTACK_VERSION=latest
